# ── Chiné · environnement PRODUCTION (Railway) ─────────────────────────────────
# Copier ces variables dans le service « web » de l'environnement production.
# Les valeurs ${{...}} sont des références Railway (résolues par la plateforme).
#
# Ce gabarit démarre tel quel : chaque service externe non configuré (IA, photos,
# e-mails) est neutralisé par défaut et se rallume variable par variable, comme
# indiqué en commentaire. Avant d'ouvrir au public, les trois bascules signalées
# ci-dessous (IA, photos, e-mails) doivent être faites, en plus du secret de session.
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://chine.app
BETTER_AUTH_URL=https://chine.app
# À REMPLACER OBLIGATOIREMENT : `openssl rand -base64 48`.
# Laissée telle quelle, la valeur ci-dessous fait échouer la validation de
# l'environnement (32 caractères minimum exigés quand NODE_ENV=production,
# apps/web/src/lib/env.ts) et le conteneur ne démarre pas.
BETTER_AUTH_SECRET=A_REMPLACER
DATABASE_URL=${{Postgres.DATABASE_URL}}
CHINE_AUTO_MIGRATE=true
CHINE_JOBS=true                     # tâches de fond (relais d'outbox, purges) ; false sur une instance secondaire
LOG_LEVEL=info

# Plateforme : sans ce chemin, Railway ignore railway.json et tente son builder
# automatique railpack, qui échoue sur ce monorepo.
RAILWAY_DOCKERFILE_PATH=apps/web/Dockerfile

# IA : chaîne de fournisseurs (repli automatique dans l'ordre).
# `auto` ne retient que les fournisseurs dont la clé est présente : sans aucune clé,
# la chaîne est vide, le démarrage réussit et seule l'expertise renvoie NOT_CONFIGURED.
# Un fournisseur NOMMÉ sans sa clé lève AppraiserError NOT_CONFIGURED dès le démarrage
# (packages/infrastructure/src/ai/index.ts) : passer à « anthropic,gemini » UNE FOIS
# ANTHROPIC_API_KEY et GEMINI_API_KEY renseignées, pas avant.
APPRAISER_DRIVER=auto
APPRAISER_TIMEOUT_MS=45000          # délai maximal par tentative et par fournisseur
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_EFFORT=low
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=                       # identifiant exact du modèle vision, obligatoire si openai est listé

# Photos (Cloudflare R2, bucket dédié à la production)
# `auto` bascule seul sur R2 dès que les cinq variables R2_* sont renseignées, et
# retombe sur le stockage local (éphémère sur Railway : les photos seraient perdues à
# chaque redéploiement) sinon. Mettre « r2 » une fois les identifiants en place pour
# l'exiger : avec une configuration R2 incomplète, la fabrique lève « STORAGE_DRIVER=r2
# mais la configuration R2 est incomplète » (packages/infrastructure/src/storage/index.ts)
# et le conteneur ne démarre pas.
# Dossier de données (photos en mode local, base PGlite). DOIT pointer sur un volume
# Railway monté à ce chemin : sans volume, les photos sont perdues à chaque
# redéploiement, et /app n'est pas inscriptible par l'utilisateur « node » de l'image.
CHINE_DATA_DIR=/data
STORAGE_DRIVER=auto
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=chine-photos
R2_PUBLIC_BASE_URL=https://photos.chine.app

# E-mails (clé Resend de production) et facturation (clés Stripe LIVE)
RESEND_API_KEY=
# Dérogation : avec NODE_ENV=production, une RESEND_API_KEY vide fait échouer la
# validation de l'environnement. « true » autorise le démarrage sans service d'e-mail,
# au prix du mot de passe oublié et de la vérification d'adresse (indisponibles, et
# journalisés au démarrage). Repasser à false dès que RESEND_API_KEY est renseignée :
# laisser true en production ouverte au public n'est pas acceptable.
CHINE_ALLOW_NO_MAILER=true
MAIL_FROM="Chiné <bonjour@chine.app>"
# Laisser VIDE tant que la vraie clé n'est pas connue : une valeur non vide (même factice)
# active la passerelle Stripe et fait échouer checkout, portail et webhooks au runtime,
# sans aucune erreur au démarrage. Vide = passerelle neutre, 503 explicite et honnête.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_AUTOMATIC_TAX=false          # true quand Stripe Tax est activé sur le compte (TVA UE, adresse et n° TVA collectés)
STRIPE_TRIAL_DAYS=14                # essai sans carte sur les plans payants (0 pour désactiver)
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# Observabilité (tout est inactif tant qu'aucun DSN n'est fourni)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production   # étiquette côté navigateur, inlinée au build Docker
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ORG=                                 # organisation Sentry, pour l'envoi des source maps au build
SENTRY_PROJECT=                             # projet Sentry ; l'envoi n'a lieu qu'avec SENTRY_AUTH_TOKEN
