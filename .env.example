# ── Base de données ─────────────────────────────────────────────
# Laisser vide en dev : PGlite (Postgres embarqué) écrit dans .data/pglite
DATABASE_URL=
CHINE_DATA_DIR=.data

# ── Auth (Better Auth) ──────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-32-chars-minimum-please
BETTER_AUTH_URL=http://localhost:3000

# ── IA (facultatif : sans clé, l'expert IA de démonstration répond) ──
APPRAISER_DRIVER=auto            # auto | gemini | fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Photos (facultatif : sans R2, stockage local dans .data/uploads) ──
STORAGE_DRIVER=auto              # auto | r2 | local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=chine-photos
R2_PUBLIC_BASE_URL=

# ── Facturation (facultatif) ────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── E-mails transactionnels (vérification, mot de passe oublié) ──
RESEND_API_KEY=
MAIL_FROM="Chiné <bonjour@chine.app>"

# ── Observabilité (facultatif) ──────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1
