{
  "name": "@chine/application",
  "version": "0.1.0",
  "private": true,
  "description": "Chiné — couche application : cas d'usage, ports, DTOs. Dépend uniquement du domaine.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "biome check src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@chine/domain": "workspace:*"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
