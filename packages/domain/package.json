{
  "name": "@chine/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Chiné — cœur métier pur (DDD). Zéro dépendance.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
