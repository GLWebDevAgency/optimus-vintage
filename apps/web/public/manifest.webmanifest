{
  "id": "/app",
  "name": "Chiné",
  "short_name": "Chiné",
  "description": "L'app des chineurs : stock, sources, marge et expert IA pour la revente de vêtements de seconde main.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "theme_color": "#F2EDE2",
  "background_color": "#F2EDE2",
  "categories": ["business", "finance", "productivity", "shopping"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/apple-touch-icon.png", "sizes": "180x180", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Chiner", "short_name": "Chiner", "description": "Ajouter une pièce", "url": "/app/chiner", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Stock", "url": "/app/stock", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Ventes", "url": "/app/ventes", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "prefer_related_applications": false
}
