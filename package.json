{
  "name": "chine",
  "private": true,
  "version": "0.1.0",
  "description": "Chiné — l'app des revendeurs de vêtements de seconde main. Monorepo Turborepo.",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22.12", "pnpm": ">=10" },
  "scripts": {
    "dev": "turbo run dev --filter=@chine/web",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:generate": "pnpm --filter @chine/infrastructure db:generate",
    "db:migrate": "pnpm --filter @chine/infrastructure db:migrate",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
