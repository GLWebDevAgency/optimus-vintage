{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd api && npm ci --include=dev && npm run build",
    "nixpacksConfigPath": "api/nixpacks.toml",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "nixPkgs": ["...", "nodejs_20"]
        }
      }
    },
    "watchPatterns": ["api/**"]
  },
  "deploy": {
    "startCommand": "cd api && npm start",
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
